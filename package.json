{
  "name": "@canifly/api",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "tsx -e \"import { ensurePostgisSchema } from './src/lib/db/client.ts'; ensurePostgisSchema().then(() => console.log('ok')).catch((e) => { console.error(e); process.exit(1); })\"",
    "ingest:ed318": "tsx scripts/ingest-ed318.ts",
    "seed:pilots": "tsx scripts/seed-pilots.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@canifly/middleware": "file:../CanIFly-middleware",
    "@hono/node-server": "^1.19.0",
    "@turf/boolean-point-in-polygon": "^7.3.5",
    "@turf/helpers": "^7.3.5",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.9.0",
    "jose": "^6.2.4",
    "postgres": "^3.4.9",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
