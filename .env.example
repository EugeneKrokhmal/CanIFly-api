DATABASE_URL=postgresql://canifly:canifly@localhost:5432/canifly
ENAIRE_INGEST_SECRET=change-me-to-a-long-random-secret
JWT_SECRET=change-me-to-a-long-random-jwt-secret
PORT=4000
CORS_ORIGIN=http://localhost:3000
# Public web origin used in verification emails (no trailing slash)
APP_URL=http://localhost:3000
# Resend (https://resend.com) — required in production for verification emails
RESEND_API_KEY=
MAIL_FROM=CanIFly <onboarding@resend.dev>
# Durable photo storage (Supabase Storage). Without these, files go to local ./uploads (wiped on Render redeploy).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=canifly-uploads
# OpenSky OAuth2 (Account → API client). Optional — if unreachable from your host,
# the API falls back to community ADS-B (adsb.lol / airplanes.live).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Fail-fast when OpenSky is blocked (ms). Default 8000.
# OPENSKY_TIMEOUT_MS=8000
